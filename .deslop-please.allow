# Run deslop-please --allow .deslop-please.allow to apply these reviewed exceptions.

# Independent benchmark targets, workspace members, and contract-test topics each have their own entry.
wide-directory benches/
wide-directory crates/
wide-directory src/tests/storage_contract/

# The downstream compile fixture implements every required SDK method.
long-file crates/hubuum-storage-core/tests/complete_external_adapter.rs

# The SDK root publishes the complete backend-neutral storage contract.
shallow-module hubuum_storage_core

# Adapters consume these query options through the query API. Filter and sort collections enforce their own bounds.
field-leak hubuum_query::QueryOptions::filters
field-leak hubuum_query::QueryOptions::include_total
field-leak hubuum_query::QueryOptions::sort
field-leak hubuum_query::QueryOptions::structured_filter

# Resolved targets expose borrowed domain views and forward the original resolved storage value across the application boundary.
field-leak hubuum::models::class::ResolvedClassTarget::class
field-leak hubuum::models::class::ResolvedClassTarget::storage
field-leak hubuum::models::object::ResolvedObjectTarget::class
field-leak hubuum::models::object::ResolvedObjectTarget::object
field-leak hubuum::models::object::ResolvedObjectTarget::storage

# Relation services pass the validated storage value by reference to create or delete the relation.
field-leak hubuum::models::relation::PreparedClassRelation::storage
field-leak hubuum::models::relation::PreparedObjectRelation::storage
field-leak hubuum::models::relation::ResolvedObjectRelationTarget::storage

# Each export schema points to a typed documentation example which constructs that same schema.
tangle hubuum::models::export::ExportJsonResponse,hubuum::models::export::openapi_examples::export_json_response_example
tangle hubuum::models::export::ExportLimits,hubuum::models::export::openapi_examples::export_limits_example
tangle hubuum::models::export::ExportMeta,hubuum::models::export::openapi_examples::export_meta_example
tangle hubuum::models::export::ExportRelationContext,hubuum::models::export::openapi_examples::export_relation_context_example
tangle hubuum::models::export::ExportRequest,hubuum::models::export::openapi_examples::export_request_example
tangle hubuum::models::export::ExportScope,hubuum::models::export::openapi_examples::export_scope_example
tangle hubuum::models::export::ExportTemplateRunRequest,hubuum::models::export::openapi_examples::export_template_run_request_example
tangle hubuum::models::export::ExportWarning,hubuum::models::export::openapi_examples::export_warning_example

# Each versioned API resource has its own route handlers. Keeping those resource names visible mirrors the API.
wide-directory src/api/v1/handlers/

# Each metric family has an independent definition file. The operational contract inventories those files for owners and labels.
wide-directory src/observability/metrics/

# Each file forwards one storage capability through the opaque handle. Consumers select capabilities by operation.
wide-directory src/storage/context/

# Each domain resource owns its models and its use cases in these repository-defined layers.
wide-directory src/models/
wide-directory src/services/

# This suite registers independently named behavior and architecture tests. Cargo discovers them through the module tree.
wide-directory src/tests/

# The domain package exports independently validated IDs, limits and value types to application and adapter crates.
shallow-module hubuum_domain

# Downstream adapters use the public query parser, cursor, filter and sort representations from this crate root.
shallow-module hubuum_query

# Producers and sink integrations share the public event envelope, actor provenance and audit vocabulary.
shallow-module hubuum_events_core

# Every backend implements the same persisted settings groups and revision contract. Each group has its own validated representation.
shallow-module hubuum_storage_core::runtime_settings

# Adapters implement the shared paging, navigation and version projections exposed by the history contract.
shallow-module hubuum_storage_core::history

# The handle deliberately exposes operation-specific capabilities and owns backend dispatch and common observation.
shallow-module hubuum::storage::context

# Authorization consumers share the principal, resource and context contracts while policy selection stays behind this module.
shallow-module hubuum::permissions

