    {
      "name": "HubuumScrapeUnavailable fires and recovers",
      "interval": "1m",
      "input_series": [
        {
          "series": "up{deployment=\"test\",instance=\"one\",job=\"hubuum\"}",
          "values": "1+0x4 0+0x20 1+0x100"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "4m",
          "alertname": "HubuumScrapeUnavailable",
          "exp_alerts": []
        },
        {
          "eval_time": "20m",
          "alertname": "HubuumScrapeUnavailable",
          "exp_alerts": [
            {
              "exp_labels": {
                "deployment": "test",
                "instance": "one",
                "job": "hubuum",
                "severity": "warning",
                "component": "process"
              },
              "exp_annotations": {
                "summary": "A configured Hubuum process cannot be scraped",
                "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/availability.md"
              }
            }
          ]
        },
        {
          "eval_time": "90m",
          "alertname": "HubuumScrapeUnavailable",
          "exp_alerts": []
        }
      ]
    },
