{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "PrometheusRule",
  "metadata": {
    "name": "hubuum",
    "labels": {
      "app.kubernetes.io/name": "hubuum"
    }
  },
  "spec": {
    "groups": [
      {
        "name": "hubuum.recording",
        "interval": "30s",
        "rules": [
          {
            "record": "hubuum:api_requests:rate5m",
            "expr": "sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[5m]))"
          },
          {
            "record": "hubuum:api_error_ratio:rate5m",
            "expr": "(sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=\"5xx\"}[5m])) or (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[5m])) * 0)) / (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[5m])))"
          },
          {
            "record": "hubuum:api_error_budget_burn:rate5m",
            "expr": "hubuum:api_error_ratio:rate5m / 0.001"
          },
          {
            "record": "hubuum:api_latency_bad_ratio:rate5m",
            "expr": "1 - (sum by (deployment) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\",le=\"1\"}[5m]))) / (sum by (deployment) (rate(hubuum_http_request_duration_seconds_count{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[5m])))"
          },
          {
            "record": "hubuum:api_latency_budget_burn:rate5m",
            "expr": "hubuum:api_latency_bad_ratio:rate5m / 0.01"
          },
          {
            "record": "hubuum:api_requests:rate30m",
            "expr": "sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[30m]))"
          },
          {
            "record": "hubuum:api_error_ratio:rate30m",
            "expr": "(sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=\"5xx\"}[30m])) or (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[30m])) * 0)) / (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[30m])))"
          },
          {
            "record": "hubuum:api_error_budget_burn:rate30m",
            "expr": "hubuum:api_error_ratio:rate30m / 0.001"
          },
          {
            "record": "hubuum:api_latency_bad_ratio:rate30m",
            "expr": "1 - (sum by (deployment) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\",le=\"1\"}[30m]))) / (sum by (deployment) (rate(hubuum_http_request_duration_seconds_count{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[30m])))"
          },
          {
            "record": "hubuum:api_latency_budget_burn:rate30m",
            "expr": "hubuum:api_latency_bad_ratio:rate30m / 0.01"
          },
          {
            "record": "hubuum:api_requests:rate1h",
            "expr": "sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[1h]))"
          },
          {
            "record": "hubuum:api_error_ratio:rate1h",
            "expr": "(sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=\"5xx\"}[1h])) or (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[1h])) * 0)) / (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[1h])))"
          },
          {
            "record": "hubuum:api_error_budget_burn:rate1h",
            "expr": "hubuum:api_error_ratio:rate1h / 0.001"
          },
          {
            "record": "hubuum:api_latency_bad_ratio:rate1h",
            "expr": "1 - (sum by (deployment) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\",le=\"1\"}[1h]))) / (sum by (deployment) (rate(hubuum_http_request_duration_seconds_count{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[1h])))"
          },
          {
            "record": "hubuum:api_latency_budget_burn:rate1h",
            "expr": "hubuum:api_latency_bad_ratio:rate1h / 0.01"
          },
          {
            "record": "hubuum:api_requests:rate6h",
            "expr": "sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[6h]))"
          },
          {
            "record": "hubuum:api_error_ratio:rate6h",
            "expr": "(sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=\"5xx\"}[6h])) or (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[6h])) * 0)) / (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[6h])))"
          },
          {
            "record": "hubuum:api_error_budget_burn:rate6h",
            "expr": "hubuum:api_error_ratio:rate6h / 0.001"
          },
          {
            "record": "hubuum:api_latency_bad_ratio:rate6h",
            "expr": "1 - (sum by (deployment) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\",le=\"1\"}[6h]))) / (sum by (deployment) (rate(hubuum_http_request_duration_seconds_count{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[6h])))"
          },
          {
            "record": "hubuum:api_latency_budget_burn:rate6h",
            "expr": "hubuum:api_latency_bad_ratio:rate6h / 0.01"
          },
          {
            "record": "hubuum:api_requests:rate30d",
            "expr": "sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[30d]))"
          },
          {
            "record": "hubuum:api_error_ratio:rate30d",
            "expr": "(sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=\"5xx\"}[30d])) or (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[30d])) * 0)) / (sum by (deployment) (rate(hubuum_http_requests_total{route=~\"/api/.*\",status_family=~\"2xx|3xx|5xx\"}[30d])))"
          },
          {
            "record": "hubuum:api_error_budget_burn:rate30d",
            "expr": "hubuum:api_error_ratio:rate30d / 0.001"
          },
          {
            "record": "hubuum:api_latency_bad_ratio:rate30d",
            "expr": "1 - (sum by (deployment) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\",le=\"1\"}[30d]))) / (sum by (deployment) (rate(hubuum_http_request_duration_seconds_count{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[30d])))"
          },
          {
            "record": "hubuum:api_latency_budget_burn:rate30d",
            "expr": "hubuum:api_latency_bad_ratio:rate30d / 0.01"
          },
          {
            "record": "hubuum:api_route_latency_p50:5m",
            "expr": "histogram_quantile(0.5, sum by (deployment, route, method, le) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[5m])))"
          },
          {
            "record": "hubuum:api_route_latency_p95:5m",
            "expr": "histogram_quantile(0.95, sum by (deployment, route, method, le) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[5m])))"
          },
          {
            "record": "hubuum:api_route_latency_p99:5m",
            "expr": "histogram_quantile(0.99, sum by (deployment, route, method, le) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[5m])))"
          },
          {
            "record": "hubuum:api_latency_p95:5m",
            "expr": "histogram_quantile(0.95, sum by (deployment, le) (rate(hubuum_http_request_duration_seconds_bucket{route=~\"/api/.*\",status_family=~\"2xx|3xx\"}[5m])))"
          },
          {
            "record": "hubuum:pool_utilization:ratio",
            "expr": "max by (deployment, instance) (hubuum_db_pool_connections{state=\"checked_out\"}) / max by (deployment, instance) (hubuum_db_pool_connections{state=\"configured\"})"
          },
          {
            "record": "hubuum:task_queue_age:seconds",
            "expr": "max by (deployment, kind) (hubuum_task_oldest_age_seconds{state=\"queued\"})"
          },
          {
            "record": "hubuum:event_queue_age:seconds",
            "expr": "max by (deployment, queue) (hubuum_event_oldest_age_seconds)"
          },
          {
            "record": "hubuum:event_queue:items",
            "expr": "max by (deployment, queue, state) (hubuum_event_queue_items)"
          },
          {
            "record": "hubuum:api_replicas:available",
            "expr": "sum by (deployment) ((up{job=\"hubuum\"} == 1) * on (deployment, instance) group_left() (hubuum_runtime_info{role=~\"all|api\"} == 1))"
          },
          {
            "record": "hubuum:worker_processes:available",
            "expr": "sum by (deployment) ((up{job=\"hubuum\"} == 1) * on (deployment, instance) group_left() (hubuum_runtime_info{role=~\"all|worker\"} == 1))"
          },
          {
            "record": "hubuum:task_failure:recent",
            "expr": "time() - max by (deployment, kind) (hubuum_task_last_terminal_timestamp_seconds{status=\"failed\"}) < bool 3600"
          },
          {
            "record": "hubuum:event_dead:increase1h",
            "expr": "clamp_min(delta(hubuum:event_queue:items{queue=\"delivery\",state=\"dead\"}[1h]), 0)"
          },
          {
            "record": "hubuum:scrape_age:seconds",
            "expr": "time() - timestamp(up{job=\"hubuum\"})"
          }
        ]
      },
      {
        "name": "hubuum.operations",
        "interval": "1m",
        "rules": [
          {
            "alert": "HubuumDatabasePoolSaturated",
            "expr": "max by (deployment, instance) (hubuum_db_pool_connections{state=\"checked_out\"}) / max by (deployment, instance) (hubuum_db_pool_connections{state=\"configured\"}) > 0.9",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "component": "database"
            },
            "annotations": {
              "summary": "Database pool remains above 90% utilization",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/database-pool.md"
            }
          },
          {
            "alert": "HubuumTaskQueueDelayed",
            "expr": "max by (deployment, kind) (hubuum_task_oldest_age_seconds{state=\"queued\"}) > 300",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "component": "tasks"
            },
            "annotations": {
              "summary": "Queued work has exceeded five minutes",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/task-queue.md"
            }
          },
          {
            "alert": "HubuumWorkerErrors",
            "expr": "sum by (deployment) (increase(hubuum_task_worker_iterations_total{outcome=\"error\"}[10m])) > 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "tasks"
            },
            "annotations": {
              "summary": "Task workers are reporting errors",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/worker-errors.md"
            }
          },
          {
            "alert": "HubuumEventBacklog",
            "expr": "max by (deployment, queue) (hubuum_event_oldest_age_seconds) > 300",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "component": "events"
            },
            "annotations": {
              "summary": "Event processing has exceeded five minutes",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/event-backlog.md"
            }
          },
          {
            "alert": "HubuumBackupFailed",
            "expr": "sum by (deployment) (increase(hubuum_task_completions_total{kind=\"backup\",final_status=\"failed\"}[1h])) > 0",
            "for": "0m",
            "labels": {
              "severity": "warning",
              "component": "recovery"
            },
            "annotations": {
              "summary": "A backup task failed during the last hour",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/backup-failure.md"
            }
          },
          {
            "alert": "HubuumMetricsRefreshStale",
            "expr": "time() - hubuum_metrics_refresh_last_success_timestamp_seconds > 300 or (hubuum_metrics_refresh_failures_total > 0 unless hubuum_metrics_refresh_last_success_timestamp_seconds)",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "metrics"
            },
            "annotations": {
              "summary": "Metrics inventory has not refreshed for five minutes",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/metrics-stale.md"
            }
          }
        ]
      },
      {
        "name": "hubuum.extended",
        "interval": "1m",
        "rules": [
          {
            "alert": "HubuumScrapeUnavailable",
            "expr": "up{job=\"hubuum\"} == 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "process"
            },
            "annotations": {
              "summary": "A configured Hubuum process cannot be scraped",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/availability.md"
            }
          },
          {
            "alert": "HubuumNoReadyApi",
            "expr": "max by (deployment) (probe_success{job=\"hubuum-readiness\"}) == 0",
            "for": "2m",
            "labels": {
              "severity": "critical",
              "component": "api"
            },
            "annotations": {
              "summary": "No probed API replica is ready",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/availability.md"
            }
          },
          {
            "alert": "HubuumApiAvailabilityBurn",
            "expr": "hubuum:api_error_budget_burn:rate1h > 14.4 and hubuum:api_error_budget_burn:rate5m > 14.4",
            "for": "2m",
            "labels": {
              "severity": "critical",
              "component": "api"
            },
            "annotations": {
              "summary": "API availability is consuming the monthly budget rapidly",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/api-slo.md"
            }
          },
          {
            "alert": "HubuumApiAvailabilitySlowBurn",
            "expr": "hubuum:api_error_budget_burn:rate6h > 6 and hubuum:api_error_budget_burn:rate30m > 6",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "api"
            },
            "annotations": {
              "summary": "API availability is consuming the monthly budget",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/api-slo.md"
            }
          },
          {
            "alert": "HubuumApiLatencyBurn",
            "expr": "hubuum:api_latency_budget_burn:rate1h > 14.4 and hubuum:api_latency_budget_burn:rate5m > 14.4",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "api"
            },
            "annotations": {
              "summary": "Successful API requests are exceeding the latency objective",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/api-slo.md"
            }
          },
          {
            "alert": "HubuumDatabaseAcquireFailures",
            "expr": "sum by (deployment, instance) (increase(hubuum_db_connection_acquire_failures_total[10m])) > 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "database"
            },
            "annotations": {
              "summary": "Database connection acquisition is failing",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/database-pool.md"
            }
          },
          {
            "alert": "HubuumNoTaskWorkers",
            "expr": "max by (deployment) (hubuum_tasks{status=\"queued\"}) > 0 unless on (deployment) (sum by (deployment) (hubuum_task_workers_configured * on (deployment, instance) group_left() (up{job=\"hubuum\"} == 1)) > 0)",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "tasks"
            },
            "annotations": {
              "summary": "Queued tasks have no reachable configured workers",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/worker-errors.md"
            }
          },
          {
            "alert": "HubuumEventDeadLetters",
            "expr": "max by (deployment) (hubuum_event_queue_items{queue=\"delivery\",state=\"dead\"}) > 0",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "component": "events"
            },
            "annotations": {
              "summary": "Dead event deliveries require investigation",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/event-backlog.md"
            }
          },
          {
            "alert": "HubuumEventClaimsStale",
            "expr": "max by (deployment, queue) (hubuum_event_stale_claims) > 0",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "component": "events"
            },
            "annotations": {
              "summary": "Event claims remain stale",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/event-backlog.md"
            }
          },
          {
            "alert": "HubuumIdentityBackendFailures",
            "expr": "sum by (deployment) (increase(hubuum_login_limiter_backend_failures_total[10m])) > 0 or sum by (deployment) (increase(hubuum_api_errors_total{class=\"permission_backend_unavailable\"}[10m])) > 0 or sum by (deployment) (increase(hubuum_login_attempts_total{outcome=\"internal_error\"}[10m])) > 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "identity"
            },
            "annotations": {
              "summary": "Authentication or authorization dependencies are failing",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/identity.md"
            }
          },
          {
            "alert": "HubuumEphemeralTokenKey",
            "expr": "max by (deployment, instance) (hubuum_token_hash_key_info{mode=\"ephemeral\"}) == 1",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "component": "identity"
            },
            "annotations": {
              "summary": "A token key will change on process restart",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/identity.md"
            }
          },
          {
            "alert": "HubuumOutputCleanupFailures",
            "expr": "sum by (deployment, kind) (increase(hubuum_task_output_cleanup_failures_total[1h])) > 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "storage"
            },
            "annotations": {
              "summary": "Stored output retention cleanup is failing",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/retention.md"
            }
          },
          {
            "alert": "HubuumEventRetentionFailures",
            "expr": "sum by (deployment) (increase(hubuum_db_operation_errors_total{caller=\"event_retention\"}[1h])) > 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "storage"
            },
            "annotations": {
              "summary": "Event retention database operations are failing",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/retention.md"
            }
          },
          {
            "alert": "HubuumOperatorJobFailed",
            "expr": "hubuum_operator_job_success == 0",
            "for": "0m",
            "labels": {
              "severity": "warning",
              "component": "recovery"
            },
            "annotations": {
              "summary": "An externally supervised operator job failed",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/operator-jobs.md"
            }
          },
          {
            "alert": "HubuumOperatorJobOverdue",
            "expr": "(time() - hubuum_operator_job_last_success_timestamp_seconds > hubuum_operator_job_max_age_seconds) or (hubuum_operator_job_expected == 1 unless on (deployment, operation) hubuum_operator_job_last_success_timestamp_seconds)",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "recovery"
            },
            "annotations": {
              "summary": "An expected operator job has no recent successful completion",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/operator-jobs.md"
            }
          },
          {
            "alert": "HubuumIntegrationProbeFailed",
            "expr": "probe_success{job=\"hubuum-integrations\"} == 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "component": "{{ $labels.component }}"
            },
            "annotations": {
              "summary": "An external integration probe is failing",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/integrations.md"
            }
          },
          {
            "alert": "HubuumFileDescriptorsHigh",
            "expr": "(process_open_fds{job=\"hubuum\"} / process_max_fds{job=\"hubuum\"} > 0.9) and (process_max_fds{job=\"hubuum\"} > 0)",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "component": "process"
            },
            "annotations": {
              "summary": "A process is close to its file descriptor limit",
              "runbook_url": "https://github.com/hubuum/hubuum/blob/main/observability/runbooks/availability.md"
            }
          }
        ]
      }
    ]
  }
}
