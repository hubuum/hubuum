{
  "uid": "hubuum-api",
  "title": "Hubuum API",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "hubuum"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "hubuum"
      ],
      "asDropdown": true,
      "title": "Hubuum dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"hubuum\"}, deployment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Application requests",
      "type": "timeseries",
      "description": "SLO traffic excludes client errors, probes, metrics, Swagger and OpenAPI.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:api_requests:rate5m{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Status distribution",
      "type": "timeseries",
      "description": "All application statuses, including client errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, status_family) (rate(hubuum_http_requests_total{deployment=~\"$deployment\",route=~\"/api/.*\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Requests by route and method",
      "type": "timeseries",
      "description": "Bounded route templates and methods, never raw URL paths.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, route, method) (rate(hubuum_http_requests_total{deployment=~\"$deployment\",route=~\"/api/.*\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latency p50 by route and method",
      "type": "timeseries",
      "description": "Stable route templates and methods only; successful API requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:api_route_latency_p50:5m{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latency p95 by route and method",
      "type": "timeseries",
      "description": "Stable route templates and methods only; successful API requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:api_route_latency_p95:5m{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Latency p99 by route and method",
      "type": "timeseries",
      "description": "Stable route templates and methods only; successful API requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:api_route_latency_p99:5m{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "title": "In-flight requests",
      "type": "timeseries",
      "description": "Process-local API requests summed across replicas; excludes probes and metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, route) (hubuum_http_requests_in_flight{deployment=~\"$deployment\",route=~\"/api/.*\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "title": "Authorization and request errors",
      "type": "timeseries",
      "description": "Bounded public error classes include permission and input/resource limits.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, class) (rate(hubuum_api_errors_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "title": "Allowlist rejections",
      "type": "timeseries",
      "description": "No source addresses or user identities are exposed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, reason) (rate(hubuum_client_allowlist_rejections_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "title": "Authentication failures",
      "type": "timeseries",
      "description": "Bounded outcomes without principals or addresses.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, outcome) (rate(hubuum_login_attempts_total{deployment=~\"$deployment\",outcome!=\"success\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "title": "Login limiter failures and fallback",
      "type": "timeseries",
      "description": "Shared limiter errors trigger local enforcement fallback.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, operation) (rate(hubuum_login_limiter_backend_failures_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 12,
      "title": "Process memory",
      "type": "timeseries",
      "description": "Tune instance resource limits to observed workloads.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"hubuum\",deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 13,
      "title": "Process CPU",
      "type": "timeseries",
      "description": "Per process CPU usage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"hubuum\",deployment=~\"$deployment\"}[5m])",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}
