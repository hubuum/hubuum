{
  "uid": "hubuum-tasks",
  "title": "Hubuum tasks and workers",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "hubuum"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "hubuum"
      ],
      "asDropdown": true,
      "title": "Hubuum dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"hubuum\"}, deployment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Task states",
      "type": "timeseries",
      "description": "Database-wide snapshot: max deduplicates replicas sharing a deployment label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (deployment, kind, status) (hubuum_tasks{deployment=~\"$deployment\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Oldest queued task",
      "type": "timeseries",
      "description": "Initial queue objective: age below 300 seconds; tune by task kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:task_queue_age:seconds{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Configured workers",
      "type": "timeseries",
      "description": "Zero on HTTP-only replicas is expected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum_task_workers_configured{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active task counts",
      "type": "timeseries",
      "description": "Database-wide snapshot: max deduplicates replicas sharing a deployment label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (deployment, kind) (hubuum_tasks{deployment=~\"$deployment\",status=\"running\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Recent terminal failures",
      "type": "timeseries",
      "description": "One indicates a retained failure within the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:task_failure:recent{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Queue wait p95",
      "type": "timeseries",
      "description": "Only claimed tasks contribute; oldest queued age also detects starvation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (deployment, kind, le) (rate(hubuum_task_queue_wait_duration_seconds_bucket{deployment=~\"$deployment\"}[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "title": "Execution p95",
      "type": "timeseries",
      "description": "Completion depends on workload size, not an API latency SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (deployment, kind, le) (rate(hubuum_task_execution_duration_seconds_bucket{deployment=~\"$deployment\"}[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "title": "Terminal outcomes",
      "type": "timeseries",
      "description": "Process counters are summed after calculating their rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, kind, final_status) (rate(hubuum_task_completions_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "title": "Lease recoveries",
      "type": "timeseries",
      "description": "Investigate worker restarts or blocked lease renewal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, kind) (increase(hubuum_task_lease_recoveries_total{deployment=~\"$deployment\"}[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "title": "Worker iterations",
      "type": "timeseries",
      "description": "Claimed, idle and error outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, outcome) (rate(hubuum_task_worker_iterations_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "title": "Export render/query phases",
      "type": "timeseries",
      "description": "Avoid unbounded per-task and template-name dimensions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (deployment, phase, le) (rate(hubuum_export_phase_duration_seconds_bucket{deployment=~\"$deployment\"}[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 12,
      "title": "Stored-template export duration p95",
      "type": "timeseries",
      "description": "Uses the existing bounded template-info join; identities never enter alert text or dashboard variables.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (deployment, template_id, le) (rate(hubuum_export_duration_seconds_bucket{deployment=~\"$deployment\",template_id!=\"none\"}[15m]))) * on (deployment, template_id) group_left (template_name) max by (deployment, template_id, template_name) (hubuum_export_template_info{deployment=~\"$deployment\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 13,
      "title": "Import phases p95",
      "type": "timeseries",
      "description": "Planning and execution duration by bounded result.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (deployment, phase, outcome, le) (rate(hubuum_import_phase_duration_seconds_bucket{deployment=~\"$deployment\"}[15m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 14,
      "title": "Output retention failures",
      "type": "timeseries",
      "description": "Inspect storage/recovery for cleanup and artifact health.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, kind) (increase(hubuum_task_output_cleanup_failures_total{deployment=~\"$deployment\"}[1h]))",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}
