{
  "uid": "hubuum-integrations",
  "title": "Hubuum identity and integrations",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "hubuum"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "hubuum"
      ],
      "asDropdown": true,
      "title": "Hubuum dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"hubuum\"}, deployment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Login outcomes",
      "type": "timeseries",
      "description": "Local and external identity outcomes; use controlled logs for provider-specific diagnosis.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, outcome) (rate(hubuum_login_attempts_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Shared limiter failures",
      "type": "timeseries",
      "description": "Valkey failures may cause local fallback.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, operation) (rate(hubuum_login_limiter_backend_failures_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Login lockouts",
      "type": "timeseries",
      "description": "Bounded scope only; no principals or addresses.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, scope) (rate(hubuum_login_lockouts_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Secret resolution failures",
      "type": "timeseries",
      "description": "Includes LDAP, event sinks and remote targets without exposing secrets or endpoints.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, consumer, outcome) (rate(hubuum_secret_resolutions_total{deployment=~\"$deployment\",outcome!=\"ok\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Remote HTTP outcomes",
      "type": "timeseries",
      "description": "Task remote calls, not generic event-delivery transport metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, outcome) (rate(hubuum_remote_call_results_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Authorization backend failures",
      "type": "timeseries",
      "description": "Unavailable configured permission backend, including Treetop.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment) (rate(hubuum_api_errors_total{deployment=~\"$deployment\",class=\"permission_backend_unavailable\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "title": "OTLP export outcomes",
      "type": "timeseries",
      "description": "Applicable only when tracing is configured.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, outcome) (rate(hubuum_trace_export_batches_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "title": "Integration probes (external)",
      "type": "timeseries",
      "description": "Optional probes for bounded components ldap, treetop, valkey, amqp, smtp and webhook; network probes do not prove delivery.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"hubuum-integrations\",deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}
