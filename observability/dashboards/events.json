{
  "uid": "hubuum-events",
  "title": "Hubuum events",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "hubuum"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "hubuum"
      ],
      "asDropdown": true,
      "title": "Hubuum dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"hubuum\"}, deployment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Event queue states",
      "type": "timeseries",
      "description": "Database-wide snapshot: max deduplicates replicas sharing a deployment label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:event_queue:items{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Oldest due event",
      "type": "timeseries",
      "description": "Initial objective: fanout and delivery ages below 300 seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:event_queue_age:seconds{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Dead-letter growth (net)",
      "type": "timeseries",
      "description": "Net change in retained dead rows, not a failure counter; retention can mask new dead letters.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:event_dead:increase1h{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Stale claims",
      "type": "timeseries",
      "description": "Database-wide snapshot: max deduplicates replicas sharing a deployment label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (deployment, queue) (hubuum_event_stale_claims{deployment=~\"$deployment\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Worker wakeups",
      "type": "timeseries",
      "description": "Notification and poll activity; transport outcomes require authorized delivery health reads.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, worker, kind) (rate(hubuum_event_worker_wakeups_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Configured event workers",
      "type": "timeseries",
      "description": "Inspect /api/v1/event-deliveries/health for per-sink status; never use sink IDs as metric labels.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum_event_workers_configured{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}
