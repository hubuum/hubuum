{
  "uid": "hubuum-postgresql",
  "title": "Hubuum PostgreSQL",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "hubuum"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "hubuum"
      ],
      "asDropdown": true,
      "title": "Hubuum dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"hubuum\"}, deployment)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Pool utilization",
      "type": "timeseries",
      "description": "Checked-out/configured connections per process; these are pool checkouts, not network connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum:pool_utilization:ratio{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pool connections",
      "type": "timeseries",
      "description": "Configured, open, idle and checked-out connections per process.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hubuum_db_pool_connections{deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Checkout p95",
      "type": "timeseries",
      "description": "Includes readiness and background callers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (deployment, caller, le) (rate(hubuum_db_connection_acquire_duration_seconds_bucket{deployment=~\"$deployment\"}[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Acquisition failures",
      "type": "timeseries",
      "description": "Check saturation, reachability and PostgreSQL limits.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, caller) (rate(hubuum_db_connection_acquire_failures_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pool checkout rate by caller",
      "type": "timeseries",
      "description": "Includes readiness and background checkouts, not new network connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, caller) (rate(hubuum_db_connection_acquire_duration_seconds_count{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Operation p95",
      "type": "timeseries",
      "description": "Bounded database caller categories.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (deployment, caller, le) (rate(hubuum_db_operation_duration_seconds_bucket{deployment=~\"$deployment\"}[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "title": "Database errors",
      "type": "timeseries",
      "description": "Use logs for SQLSTATE details and timeout causes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment, caller, result) (rate(hubuum_db_operation_errors_total{deployment=~\"$deployment\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "title": "Inventory",
      "type": "timeseries",
      "description": "Database-wide snapshot: max deduplicates replicas sharing a deployment label.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (deployment, entity_type) (hubuum_inventory_entities{deployment=~\"$deployment\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "title": "Readiness probes (external)",
      "type": "timeseries",
      "description": "Optional blackbox exporter checks each API /readyz; configure as described in the package.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"hubuum-readiness\",deployment=~\"$deployment\"}",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}
