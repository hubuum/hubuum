{
  "schema": "public",
  "migration_table": "__diesel_schema_migrations",
  "history_table_suffix": "_history",
  "read_only_tables": [
    "restore_success_receipts",
    "query_usage_resources",
    "query_usage_resource_owners",
    "query_usage_executor_cursor"
  ],
  "events_table": "events",
  "event_update_columns": [
    "dispatched_at",
    "fanout_locked_until",
    "fanout_claim_token"
  ],
  "runtime_functions": [
    "hubuum_complete_event_retention_purge",
    "hubuum_task_policy_read",
    "hubuum_task_capacity_snapshot",
    "hubuum_task_policy_initialize",
    "hubuum_task_policy_replace",
    "hubuum_task_capacity_lock",
    "hubuum_bind_task_artifact",
    "hubuum_task_claimable_tasks",
    "hubuum_deletion_control_read",
    "hubuum_deletion_exposure_allowed",
    "hubuum_deletion_execution_allowed",
    "hubuum_register_runtime",
    "hubuum_unregister_runtime",
    "hubuum_application_control_read",
    "hubuum_application_execution_allowed",
    "hubuum_register_runtime_isolated",
    "hubuum_capture_application_execution",
    "hubuum_acknowledge_runtime_drain",
    "hubuum_record_task_execution_claim",
    "hubuum_task_execution_claim_allowed",
    "hubuum_pending_restore_job"
  ],
  "runtime_function_policy": "all_security_invoker_plus_allowlisted_security_definer",
  "restore": "isolated_migrator_executor",
  "built_in_capabilities": [
    "advisory_locks",
    "listen_notify",
    "transaction_local_session_settings"
  ]
}
