# Local Docker Compose only. Generate a unique value with:
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Optional least-privilege topology. Leave the role passwords and URLs unset
# for the default single-login deployment. Set them when enabling split roles.
HUBUUM_DATABASE_ROLE_MODE=single
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
# HUBUUM_DATABASE_URL=postgres://hubuum_runtime:RUNTIME_PASSWORD@db/hubuum
# HUBUUM_MIGRATION_DATABASE_URL=postgres://hubuum_migrator:MIGRATOR_PASSWORD@db/hubuum

# Optional OTLP/HTTP trace export. HTTPS is required; see docs/tracing.md.
HUBUUM_TRACING_ENABLED=false
# HUBUUM_TRACING_OTLP_ENDPOINT=https://otel-collector.example.com:4318
# HUBUUM_TRACING_OTLP_HEADERS=authorization=Bearer REPLACE_ME

# Secret material defaults to environment variables. Both binaries also accept
# --secret-source and --secret-file-root; see docs/secret_sources.md.
# For custom file-backed deployments, mount the directory read-only and pass
# these settings to each container (the default Compose file does not wire them).
# HUBUUM_SECRET_SOURCE=file
# HUBUUM_SECRET_FILE_ROOT=/run/secrets/hubuum
# Runtime/shared URL: database/url; privileged admin URL: database/migration-url.
# Keep the privileged file out of API/worker mounts when using split roles.
